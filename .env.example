# BioForge Judge environment configuration
# Copy to .env and fill in only what you have. The app boots fully in fixture
# mode with every value below left blank.

# fixture | live
# "live" does NOT force live adapters; each adapter independently checks whether
# its own credentials are present and degrades visibly if they are not.
APP_MODE=fixture

DATABASE_URL=sqlite:///./bioforge.db
ARTIFACT_DIR=./artifacts

# Pace of the demo workflow in milliseconds per step (0 = as fast as possible).
DEMO_PACE_MS=550

# Deterministic seed for fixture mode. Changing this changes nothing in fixture
# mode (fixtures are fully deterministic); it is recorded in provenance so that
# stochastic live adapters remain reproducible.
RANDOM_SEED=20260815

# --- Anthropic (Claude) -------------------------------------------------------
# Official SDK: pip install anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Paperclip (literature / FDA / trials / UniProt / PDB evidence) -----------
# Integrates through the OFFICIAL PAPERCLIP CLI, not an HTTP endpoint.
#
#   1. install the CLI, then:  paperclip login
#   2. verify:                 paperclip config
#
# Nothing below is required if you have already signed in — the adapter finds the
# binary on PATH (or in ~/.local/bin) and reuses your session. It probes once at
# startup and reports `live` only if the CLI is installed, signed in, and the
# server is reachable; otherwise it serves fixture evidence and says why.
PAPERCLIP_API_KEY=
# Absolute path to the binary, if it is not on the service's PATH.
PAPERCLIP_BIN=
# Force fixture evidence even when the CLI is available (useful for demos and CI).
PAPERCLIP_ENABLED=true
# Per-call timeout. Some Paperclip calls (notably `-s proteins` search) can hang;
# a source that exceeds this is dropped with a recorded error rather than retried.
PAPERCLIP_TIMEOUT_S=90
# Results requested per source query.
PAPERCLIP_MAX_RESULTS=6
# Disk cache for identical queries. Keeps a demo fast and repeatable; 0 disables.
PAPERCLIP_CACHE_TTL_S=86400

# --- Tamarind Bio (candidate design / structure / developability) -------------
TAMARIND_API_KEY=
TAMARIND_API_URL=

# --- Biomni (target biology / bioinformatics) ---------------------------------
# Primary supported path is the import handoff: the app emits a task prompt,
# you run it in Biomni, and you POST the result file back. If the open-source
# `biomni` package is importable, the adapter will report that too.
BIOMNI_IMPORT_DIR=./data/imports

# --- Benchling ----------------------------------------------------------------
# Official SDK: pip install benchling-sdk
BENCHLING_TENANT=
BENCHLING_API_KEY=
BENCHLING_PROJECT_ID=
BENCHLING_MCP_URL=
# Benchling Model Hub is used as the INDEPENDENT structure check. It must be a
# different model family from the design path or the gate is not independent.
BENCHLING_MODEL_HUB_URL=

# --- Modal (parallel validation + hosted validator endpoint) ------------------
MODAL_VALIDATOR_URL=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Local cache for live integration results (Paperclip query results, protein metadata).
BIOFORGE_CACHE_DIR=./data/cache
